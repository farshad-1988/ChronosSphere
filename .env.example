# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/world_events?retryWrites=true&w=majority)
# If omitted or unconfigured, ChronosSphere gracefully runs with full in-memory seed store.
MONGODB_URI=""

# API_KEY: Secret key required for POST/PUT/DELETE event mutations
API_KEY="chronos-master-key-2026"
